{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "verbatimModuleSyntax": true
  },
  "include": ["index.js", "configs/**/*.js", "rules/**/*.js", "oxlint.config.ts"]
}
